# This repo now runs two personal projects behind one Render service — see
# README.md and backend/finresearch_mount.py. Copy this file to .env for
# local dev; on Render these are set as service env vars instead (see
# render.yaml — most are marked sync: false there, meaning Render's
# dashboard is the source of truth, not this repo).

# ── fda-bot (FDA/biopharma catalyst scanner) ────────────────────────────────
POLYGON_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# BiopharmCatalyst authenticated v1 API — see backend/scrapers/biopharmcatalyst.py
BPC_API_KEY=
DB_PATH=./fda_scanner.db
# Public URL of this deployment, used for its own keep-alive self-ping.
SCANNER_API_URL=https://fda-bot.onrender.com

# ── finresearch (macro/micro research dashboard) ────────────────────────────
# Official free APIs:
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# Phase 3 (optional, paid/freemium) — leave blank to keep these connectors disabled
NASDAQ_DATA_LINK_API_KEY=
BENZINGA_API_KEY=

# Chat/advisor page — needs an Anthropic API key from console.anthropic.com
# (a claude.ai Pro/Max chat subscription does NOT grant this — API usage is
# billed separately, per token). Leave blank to disable the Chat page.
# fda-bot's own learning engine (backend/signals/learning_engine.py) and
# negative-event scanner also use this same key, if set.
ANTHROPIC_API_KEY=

# Path to finresearch's own SQLite database file (separate from fda-bot's
# DB_PATH above — each app keeps its own database).
FINRESEARCH_DB_PATH=data/finresearch.db
